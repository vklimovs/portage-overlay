diff --git a/src/libifstate/link/base.py b/src/libifstate/link/base.py
index 9f4a0c4..c7bdcb4 100644
--- a/src/libifstate/link/base.py
+++ b/src/libifstate/link/base.py
@@ -493,7 +493,7 @@ class Link(ABC):
 
     def fmt_ethtool_opt(self, setting, option, value):
         if isinstance(value, bool):
-            return "on" if value else "off"
+            return ["on"] if value else ["off"]
 
         if isinstance(value, list):
             r = []
