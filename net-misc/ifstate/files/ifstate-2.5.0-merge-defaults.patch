diff --git a/src/libifstate/__init__.py b/src/libifstate/__init__.py
index 208a3c8..f5b6880 100644
--- a/src/libifstate/__init__.py
+++ b/src/libifstate/__init__.py
@@ -268,7 +268,7 @@ class IfState:
 
             if "alt-names" in ifstate:
                 alt_names = ifstate["alt-names"]
-            elif defaults.get("clear_altnames", True):
+            elif defaults.get("clear_altnames", False):
                 alt_names = []
             else:
                 alt_names = None
@@ -1192,7 +1192,12 @@ class IfState:
         return {"interfaces": ifs_links, "routing": routing}
 
     def get_defaults(self, **kwargs):
-        for default in self.defaults:
+        defaults = {}
+
+        # merge in reverse order: earlier entries take precedence, and the
+        # builtin defaults, being the last entries, have the lowest
+        # precedence
+        for default in reversed(self.defaults):
             for match in default["match"]:
                 matching = True
 
@@ -1203,9 +1208,10 @@ class IfState:
                         matching = False
 
                 if matching:
-                    return default
+                    Parser.merge(defaults, deepcopy(default))
+                    break
 
-        return {}
+        return defaults
 
     def gen_unique_ifname(self):
         """
diff --git a/src/libifstate/parser/base.py b/src/libifstate/parser/base.py
index e6fcc45..3bae4c5 100644
--- a/src/libifstate/parser/base.py
+++ b/src/libifstate/parser/base.py
@@ -135,12 +135,13 @@ class Parser(ABC):
         self.ifstate = {}
         pass
 
-    def merge(self, a, b):
+    @staticmethod
+    def merge(a, b):
         if b is not None:
             for key in b:
                 if key in a:
                     if isinstance(a[key], dict) and isinstance(b[key], dict):
-                        self.merge(a[key], b[key])
+                        Parser.merge(a[key], b[key])
                     else:
                         a[key] = b[key]
                 else:
