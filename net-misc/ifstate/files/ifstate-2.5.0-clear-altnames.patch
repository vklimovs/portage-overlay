From a5b10448563a4fcd2dce6e24a2b8a085a6330314 Mon Sep 17 00:00:00 2001
From: Vjaceslavs Klimovs <vklimovs@gmail.com>
Date: Sat, 10 Oct 2026 09:27:32 -0700
Subject: [PATCH 1/2] tests: apply altnames configs in sequence to cover
 changes and removal

---
 tests/test_altnames.py | 8 ++++----
 1 file changed, 4 insertions(+), 4 deletions(-)

diff --git a/tests/test_altnames.py b/tests/test_altnames.py
index 4a3c918..27dd00f 100644
--- a/tests/test_altnames.py
+++ b/tests/test_altnames.py
@@ -5,9 +5,9 @@ import tests
 
 def test_altnames():
     # STEP 1
-    config = resources.files(tests).joinpath("./data/altnames1.yml")
+    config1 = resources.files(tests).joinpath("./data/altnames1.yml")
 
-    result = tests.apply(config)
+    result = tests.apply(config1)
 
     assert set(result.get_link("eth0").get("altnames", [])) == set()
     assert set(result.get_link("eth1").get("altnames", [])) == {"alpha1"}
@@ -17,9 +17,9 @@ def test_altnames():
     }
 
     # STEP 2
-    config = resources.files(tests).joinpath("./data/altnames2.yml")
+    config2 = resources.files(tests).joinpath("./data/altnames2.yml")
 
-    result = tests.apply(config)
+    result = tests.apply(config1, config2)
 
     assert set(result.get_link("eth0").get("altnames", [])) == {
         "alpha0",
-- 
