#!/sbin/openrc-run
# Copyright 2026 Gentoo Authors
# Distributed under the terms of the GNU General Public License v2
# shellcheck shell=sh disable=SC2034

description="Prometheus exporter for Network UPS Tools"

command="/usr/bin/nut_exporter"
command_background="true"
command_user="nut_exporter:nut_exporter"
pidfile="/run/${RC_SVCNAME}.pid"
# logger truncates a line at 1024 bytes without -S, silently.
error_logger="/usr/bin/logger -S 65536 -t ${RC_SVCNAME} -p daemon.err"
output_logger="/usr/bin/logger -S 65536 -t ${RC_SVCNAME} -p daemon.info"

depend() {
	use net logger
	after upsd
}
